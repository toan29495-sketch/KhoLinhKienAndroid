diff --git a/app/src/main/java/vn/kholinhkien/PasswordRecoveryActivity.kt b/app/src/main/java/vn/kholinhkien/PasswordRecoveryActivity.kt
new file mode 100644
index 0000000..87708d9
--- /dev/null
+++ b/app/src/main/java/vn/kholinhkien/PasswordRecoveryActivity.kt
@@ -0,0 +1,74 @@
+package vn.kholinhkien
+
+import android.os.Bundle
+import androidx.activity.ComponentActivity
+import androidx.activity.compose.setContent
+import androidx.compose.foundation.layout.*
+import androidx.compose.material3.*
+import androidx.compose.runtime.*
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.text.input.PasswordVisualTransformation
+import androidx.compose.ui.unit.dp
+import io.github.jan.supabase.handleDeeplinks
+import kotlinx.coroutines.launch
+
+class PasswordRecoveryActivity : ComponentActivity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        SupabaseClientProvider.client.handleDeeplinks(intent)
+        setContent {
+            MaterialTheme {
+                PasswordRecoveryContent(
+                    hasSession = AuthRepository().isLoggedIn(),
+                    onSaved = { finish() },
+                    onCancel = { finish() }
+                )
+            }
+        }
+    }
+}
+
+@Composable
+private fun PasswordRecoveryContent(hasSession: Boolean, onSaved: () -> Unit, onCancel: () -> Unit) {
+    var password by remember { mutableStateOf("") }
+    var confirmation by remember { mutableStateOf("") }
+    var message by remember { mutableStateOf("") }
+    var loading by remember { mutableStateOf(false) }
+    val scope = rememberCoroutineScope()
+    val repository = remember { AuthRepository() }
+
+    Column(Modifier.fillMaxSize().padding(24.dp), horizontalAlignment = Alignment.CenterHorizontally, verticalArrangement = Arrangement.Center) {
+        Text("KHÔI PHỤC MẬT KHẨU", style = MaterialTheme.typography.headlineSmall)
+        Spacer(Modifier.height(16.dp))
+        if (!hasSession) {
+            Text("Liên kết không hợp lệ hoặc đã hết hạn. Hãy quay lại ứng dụng và gửi liên kết mới.")
+            Spacer(Modifier.height(16.dp))
+            Button(onClick = onCancel) { Text("ĐÓNG") }
+        } else {
+            Text("Email đã xác thực. Hãy tạo mật khẩu mới.")
+            Spacer(Modifier.height(16.dp))
+            OutlinedTextField(password, { password = it }, label = { Text("Mật khẩu mới (ít nhất 6 ký tự)") }, visualTransformation = PasswordVisualTransformation(), singleLine = true, modifier = Modifier.fillMaxWidth())
+            Spacer(Modifier.height(10.dp))
+            OutlinedTextField(confirmation, { confirmation = it }, label = { Text("Nhập lại mật khẩu mới") }, visualTransformation = PasswordVisualTransformation(), singleLine = true, modifier = Modifier.fillMaxWidth())
+            if (message.isNotBlank()) { Spacer(Modifier.height(10.dp)); Text(message, color = MaterialTheme.colorScheme.error) }
+            Spacer(Modifier.height(16.dp))
+            Button(onClick = {
+                when {
+                    password.length < 6 -> message = "Mật khẩu mới phải có ít nhất 6 ký tự"
+                    password != confirmation -> message = "Hai mật khẩu không trùng khớp"
+                    else -> scope.launch {
+                        loading = true
+                        message = ""
+                        try { repository.completePasswordRecovery(password); onSaved() }
+                        catch (error: Exception) { message = error.message ?: "Không thể cập nhật mật khẩu. Hãy gửi liên kết mới nếu đã hết hạn." }
+                        finally { loading = false }
+                    }
+                }
+            }, enabled = !loading, modifier = Modifier.fillMaxWidth()) {
+                if (loading) CircularProgressIndicator(Modifier.size(20.dp), strokeWidth = 2.dp) else Text("LƯU MẬT KHẨU MỚI")
+            }
+            TextButton(onClick = onCancel, enabled = !loading) { Text("Hủy") }
+        }
+    }
+}
